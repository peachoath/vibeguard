# VibeGuard 루트 .env 예시 — docker-compose 가 읽는 환경변수.
# 이 파일을 `.env`로 복사해 값을 채운 뒤 `docker compose up -d --build`.
# (api-server 컨테이너의 환경변수로 주입된다. 로컬 gradle 실행용 값은 BE/api-server/.env 참조)

# ── 프로파일 ──
# 운영 배포 시 prod 로 지정(Swagger·상세 health 비노출). 개발/데모는 비워두면 됨.
SPRING_PROFILES_ACTIVE=

# ── 배포 도메인 (AWS EC2 + Caddy HTTPS, 프로덕션 오버레이 사용 시 필수) ──
# docker-compose.prod.yml 의 Caddy가 이 도메인으로 Let's Encrypt 인증서를 자동 발급한다.
# DNS A 레코드가 EC2 퍼블릭 IP(Elastic IP 권장)를 가리켜야 하며, 보안그룹 80/443 개방 필요.
#   예: DEPLOY_DOMAIN=api.example.com
# 로컬 데모(기본 compose만)에는 불필요.
DEPLOY_DOMAIN=

# ── DB ──
# 기본값(미설정)은 컨테이너 내 postgres 사용. Supabase 관리형을 쓰려면 아래 3개를 지정.
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USER=postgres.<project-ref>
#   DB_PASSWORD=<supabase-db-password>
# DB_URL=
# DB_USER=
# DB_PASSWORD=

# 컨테이너 postgres 초기화 값(로컬 DB 사용 시).
# DB_PASSWORD를 따로 지정하지 않으면 api-server도 POSTGRES_PASSWORD를 사용한다.
POSTGRES_DB=vibeguard
POSTGRES_USER=vibeguard
POSTGRES_PASSWORD=vibeguard

# ── 호스트 노출 포트 (로컬에서 5432/8080 이 점유된 경우 변경) ──
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8088

# ── GitHub OAuth (필수) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 토큰 암호화 키 (AES-256-GCM, base64 32B). 운영에선 반드시 교체 ──
#   생성: openssl rand -base64 32
# TOKEN_ENC_KEY=

# ── FE 연동 ──
# FE 배포 도메인(크로스 오리진 CORS 허용). 쉼표로 여러 개.
#   운영(Vercel): https://vibeguard-mu.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 로그인 성공 후 리다이렉트 URL
#   운영(Vercel): https://vibeguard-mu.vercel.app/dashboard
POST_LOGIN_URI=http://localhost:3000/dashboard

# ── Agent Runner 연동 (HMAC, NFR-S4) — 에이전트 팀과 동일 값 공유 ──
RUNNER_BASE_URL=http://agent-runner:4000
RUNNER_CALLBACK_SECRET=dev-secret-change-me

# ── Claude Agent SDK (agent-runner 컨테이너가 사용) ──
# 없으면: 런너가 에이전트 세션을 건너뛴다(골격 모드). 파이프라인 상태는 흐르지만 실제 분석은 없음.
ANTHROPIC_API_KEY=

# ── Docker 소켓 GID (agent-runner가 호스트 Docker로 샌드박스 컨테이너를 띄우기 위함) ──
# agent-runner에 group_add로 부여된다. 호스트 docker 소켓의 그룹 GID와 맞지 않으면
# 소켓 접근이 EACCES로 실패한다. 이미지 기본값은 999.
#   확인·설정:  echo "DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)" >> .env
#   (macOS Docker Desktop은 대개 0. Linux VM은 docker 그룹 GID, 보통 999 또는 998)
DOCKER_GID=999
