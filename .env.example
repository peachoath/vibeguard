# ── 루트 공통 예시. 각 컴포넌트 실행 전 .env로 복사해 채우세요. ──

# GitHub OAuth (BE/api-server)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DB — Supabase 관리형 PostgreSQL 16 (PRD §12)
#   Supabase Dashboard → Project Settings → Database → Connection string 에서 확인.
#   Supavisor "세션 풀러(Session pooler, 포트 5432)"를 사용하고 sslmode=require 를 붙입니다.
#   (트랜잭션 풀러 6543은 Flyway 마이그레이션과 상성이 나빠 사용 금지)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<supabase-db-password>

# 로컬 오프라인 개발 폴백 (docker-compose의 로컬 Postgres 사용 시)
# DB_URL=jdbc:postgresql://localhost:5432/vibeguard
# DB_USER=vibeguard
# DB_PASSWORD=vibeguard

# Agent Runner (BE/agent)
ANTHROPIC_API_KEY=
NVD_API_KEY=
RUNNER_PORT=4000

# Spring Boot ↔ Runner 콜백 HMAC 서명 키 (NFR-S4)
RUNNER_CALLBACK_SECRET=dev-secret-change-me
