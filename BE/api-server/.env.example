# BE/api-server 환경변수 예시.
# 이 파일을 같은 폴더에 `.env`로 복사한 뒤 값을 채우세요.
# 부팅 시 DotenvEnvironmentPostProcessor가 .env를 자동 로드합니다.
# (실제 OS 환경변수가 설정돼 있으면 .env보다 우선합니다.)

# ── DB: Supabase 관리형 PostgreSQL 16 (Supavisor 세션 풀러, 포트 5432) ──
#   Supabase Dashboard → Connect → JDBC(Session pooler)에서 값 확인.
#   user/password는 URL에서 떼어 아래 DB_USER/DB_PASSWORD로 분리해 넣고,
#   DB_URL 끝에는 ?sslmode=require 를 붙입니다. (트랜잭션 풀러 6543 금지)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<supabase-db-password>

# ── GitHub OAuth ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub access token 암호화 키 (AES-256-GCM, NFR-S3) ──
#   base64(32바이트). 미설정 시 application.yml의 dev 기본값 사용(운영에선 반드시 교체).
#   생성 예: openssl rand -base64 32
# TOKEN_ENC_KEY=

# ── Spring Boot ↔ Runner 콜백 HMAC 서명 키 (NFR-S4) ──
RUNNER_CALLBACK_SECRET=dev-secret-change-me

# ── 로컬 오프라인 개발 폴백 (docker-compose 로컬 Postgres 사용 시) ──
# DB_URL=jdbc:postgresql://localhost:5432/vibeguard
# DB_USER=vibeguard
# DB_PASSWORD=vibeguard
