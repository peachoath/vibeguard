# BE/agent (Node 런너 + MCP) 환경변수 예시.
# 이 파일을 같은 폴더에 `.env`로 복사한 뒤 값을 채우세요.

# ── Claude Agent SDK ──
# 없으면: 러너가 에이전트 세션을 건너뛴다(골격 모드). 파이프라인 상태는 흘러가지만 실제 분석은 일어나지 않는다.
ANTHROPIC_API_KEY=

# ── 취약점 DB 조회 (advisory-mcp) ──
# 없어도 동작한다. 없으면: NVD 조회가 5분에 5회로 제한되고, 제한에 걸리면 OSV.dev로 폴백한다.
NVD_API_KEY=
# 없어도 동작한다. 없으면: GHSA 조회가 시간당 60회로 제한되고, 넘으면 github_advisory가 실패로 응답한다.
# A4(PR 생성)에도 필요하다. 없으면 GitHub MCP 서버가 뜨지 않아 PR_CREATING 단계가 실패한다.
GITHUB_TOKEN=
# (OSV.dev 조회는 키가 필요 없다)

# ── 에이전트 세션 ──
# 세션이 쓰는 모델. 별칭(haiku·sonnet·opus) 또는 모델 ID. 기본값 sonnet.
AGENT_MODEL=sonnet
# 세션 1개당 비용 상한(USD). 넘으면 SDK가 세션을 중단한다. 기본값 0.5.
AGENT_MAX_BUDGET_USD=0.5
# 1로 두면 Claude API를 호출하지 않고 목 출력으로 전체 파이프라인 흐름을 검증한다(비용 0).
# DRY_RUN=1

# ── 런너 ──
RUNNER_PORT=4000
# 스캔 작업 폴더(클론본·venv·결과물). 비우면 /tmp/vibeguard 아래를 쓴다.
# VIBEGUARD_WORK_DIR=
# 1로 두면 스캔이 끝나도 작업 폴더를 지우지 않는다(디버깅용).
# VIBEGUARD_KEEP_WORKDIR=
# 샌드박스가 공유하는 pip·Trivy 캐시 위치(절대 경로). 비우면 ~/.cache/vibeguard를 쓴다.
# 러너를 컨테이너로 띄우는 배포에서는 호스트와 러너 컨테이너가 같은 경로로 공유하는 폴더를 지정한다.
# VIBEGUARD_CACHE_DIR=
# 러너가 샌드박스 컨테이너를 띄울 때 마운트하는 docker.sock의 그룹 GID.
# 호스트에서 stat -c %g /var/run/docker.sock 값과 맞춰야 컨테이너가 도커 소켓에 접근한다.
# 비우면 배포 스크립트/compose 기본값(999)을 쓴다. macOS Docker Desktop은 대개 0.
# DOCKER_GID=999
# Spring Boot API 서버 주소 — HMAC 콜백 전송 대상({API_BASE_URL}/api/v1/internal/runner/events)
API_BASE_URL=http://localhost:8080

# ── Spring Boot ↔ Runner 콜백 HMAC 서명 키 (NFR-S4) ──
# api-server(.env)의 값과 동일해야 합니다.
RUNNER_CALLBACK_SECRET=dev-secret-change-me
